{
  "schema_version": 1,
  "id": "bonsaicpu",
  "recipe": "bonsaicpu",
  "kind": "local",
  "metadata": {
    "display_name": "Ternary Bonsai on CPU (PrismML llama.cpp build, PQ2_0)",
    "server_name": "llama-server",
    "log_category": "BonsaiCpu",
    "binary": "llama-server",
    "config_section": "bonsaicpu",
    "default_device": "cpu",
    "slot_policy": "standard",
    "options": [],
    "support": [
      {
        "backend": "cpu",
        "tier": "guest",
        "format": "native",
        "supported_os": [
          "linux"
        ],
        "devices": {
          "cpu": [
            "x86_64"
          ]
        },
        "device_summary": "x86_64 CPU; the PrismML build carries every ggml CPU variant (AVX through AVX-512) and picks one at start",
        "arch_gates": {}
      }
    ],
    "supported_modes": [
      "chat"
    ],
    "required_checkpoints": [
      "main"
    ],
    "bin_variants": [
      "cpu"
    ],
    "exposes_prometheus_metrics": true
  },
  "install": {
    "strategy": "external_only"
  },
  "launch": {
    "prepare_order": [
      "artifacts",
      "backend",
      "program",
      "ports"
    ],
    "backend": {
      "fixed": "cpu"
    },
    "program": {
      "source": "external_or_managed",
      "install_policy": "always"
    },
    "ports": [
      {
        "name": "http",
        "reject_zero": true,
        "error": "bonsaicpu: no free port"
      }
    ],
    "argv": [
      {
        "args": [
          "-m",
          {
            "ref": "/model/checkpoint",
            "type": "string"
          },
          "--host",
          "127.0.0.1",
          "--port",
          {
            "string": {
              "ref": "/launch/ports/http"
            }
          },
          "-dev",
          "none",
          "-ngl",
          "0",
          "-c",
          "4096",
          "-np",
          "1",
          "--reasoning-budget",
          "0",
          "--metrics"
        ]
      }
    ],
    "environment": {
      "preset": "inherit",
      "set": [
        {
          "name": "CUDA_VISIBLE_DEVICES",
          "value": "-1"
        },
        {
          "name": "GGML_VK_VISIBLE_DEVICES",
          "value": "-1"
        }
      ]
    },
    "working_directory": "inherit",
    "output": {
      "inherit_levels": [
        "debug"
      ],
      "filter": false
    },
    "readiness": {
      "port": "http",
      "path": "/health",
      "timeout": 900
    },
    "watchdog": {
      "policy": "standard",
      "port": "http",
      "path": "/health"
    }
  },
  "operations": [
    {
      "operation": "chat_completion",
      "delivery": "buffered",
      "model_modes": [
        "chat"
      ],
      "transport": {
        "kind": "http_json",
        "method": "POST",
        "path": "/v1/chat/completions",
        "port": "http",
        "timeout": "global",
        "response_codec": "json.v1"
      },
      "request": {
        "base": "identity",
        "remove": [],
        "set": {},
        "omit_missing": false
      }
    },
    {
      "operation": "completion",
      "delivery": "buffered",
      "model_modes": [
        "chat"
      ],
      "transport": {
        "kind": "http_json",
        "method": "POST",
        "path": "/v1/completions",
        "port": "http",
        "timeout": "global",
        "response_codec": "json.v1"
      },
      "request": {
        "base": "identity",
        "remove": [],
        "set": {},
        "omit_missing": false
      }
    },
    {
      "operation": "chat_completion",
      "delivery": "streaming",
      "model_modes": [
        "chat"
      ],
      "transport": {
        "kind": "http_sse",
        "method": "POST",
        "path": "/v1/chat/completions",
        "port": "http",
        "timeout": "global",
        "stream_codec": "openai_sse.v1"
      },
      "request": {
        "base": "identity",
        "remove": [],
        "set": {},
        "omit_missing": false
      }
    },
    {
      "operation": "completion",
      "delivery": "streaming",
      "model_modes": [
        "chat"
      ],
      "transport": {
        "kind": "http_sse",
        "method": "POST",
        "path": "/v1/completions",
        "port": "http",
        "timeout": "global",
        "stream_codec": "openai_sse.v1"
      },
      "request": {
        "base": "identity",
        "remove": [],
        "set": {},
        "omit_missing": false
      }
    }
  ]
}
